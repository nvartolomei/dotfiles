# Userland defined completion for bash
# Loaded by `bash-completion` package

# Add tab completion for SSH hostnames based on ~/.ssh/config, ignoring wildcards
[ -e "$HOME/.ssh/config" ] && complete -o "default" -o "nospace" -W "$(grep "^Host" ~/.ssh/config | grep -v "[?*]" | cut -d " " -f2)" scp sftp ssh

# Enable git command autocompletion for 'g' as well.
# The bash-completion package loads git's rules lazily on the first
# `git <TAB>`, which happens after this file runs — force-load them.
if ! type __git_complete > /dev/null 2>&1 && type _completion_loader > /dev/null 2>&1; then
    _completion_loader git
fi
if type __git_complete > /dev/null 2>&1; then
    __git_complete g __git_main
elif type _git > /dev/null 2>&1; then
    complete -o default -o nospace -F _git g
fi

# Branch completion for `git sw` / `g sw`
# (git's completion dispatches to _git_<command> when it exists)
_git_sw() {
    __git_complete_refs
}
